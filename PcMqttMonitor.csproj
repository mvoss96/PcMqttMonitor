<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- Framework-dependent: the .NET 10 Desktop Runtime comes from the system
         (the installer downloads it when missing), so the exe is ~5 MB instead
         of ~160 MB. Set here rather than on the command line so a publish never
         picks up a self-contained build left in obj. -->
    <SelfContained>false</SelfContained>
    <!-- Native DLLs of the packages (Mono.Posix helpers) go inside the
         single-file exe; the installer ships only the exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.12.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**;tests\**" />
    <None Remove="tools\**;tests\**" />
    <!-- The test project calls internal classes (sinks, input rules) directly. -->
    <InternalsVisibleTo Include="PcMqttMonitor.Tests" />
    <!-- UseWPF drops System.IO from the implicit usings (clash with Shapes.Path).
         The WinForms namespaces are imported per file instead of globally,
         so WPF files see no duplicate type names (TextBox, Color, ToolTip...). -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

</Project>
