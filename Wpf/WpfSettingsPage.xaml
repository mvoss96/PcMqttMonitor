<UserControl x:Class="WpfSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext is the active string table (L.T); {Binding X} reads L.T.X. -->

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Margin" Value="16,0"/>
        </Style>
        <Style x:Key="Choice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style x:Key="RowSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="{Binding SettingsTitle}" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox x:Name="Interval" Style="{StaticResource Choice}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SetInterval}"/>
                            <TextBlock Text="{Binding SetIntervalSub}" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox x:Name="ThemeChoice" Style="{StaticResource Choice}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SetTheme}"/>
                            <TextBlock x:Name="ThemeSub" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <ComboBox x:Name="LanguageChoice" Style="{StaticResource Choice}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SetLanguage}"/>
                            <TextBlock Text="{Binding SetRestartSub}" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource RowSwitch}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SetAutostart}"/>
                            <TextBlock Text="{Binding SetAutostartSub}" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource RowSep}"/>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox x:Name="DebugSwitch" Style="{StaticResource RowSwitch}"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SetDebug}"/>
                            <TextBlock Text="{Binding SetDebugSub}" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <DockPanel Style="{StaticResource Row}">
                    <CheckBox x:Name="UpdateSwitch" Style="{StaticResource RowSwitch}"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SetUpdates}"/>
                        <TextBlock Text="{Binding SetUpdatesSub}" Style="{StaticResource Sub}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
