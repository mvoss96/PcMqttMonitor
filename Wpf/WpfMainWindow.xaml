<Window x:Class="WpfMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Sidebar entry: a Fluent icon, accent pill on the left when selected. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Nav" Grid.Column="0" Background="Transparent" BorderThickness="0"
                 Padding="0,4,0,0" ItemContainerStyle="{StaticResource NavItem}"
                 SelectionChanged="Nav_SelectionChanged"/>

        <!-- Page area on a slightly lighter layer, like the Windows 11 Settings app. -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Border x:Name="SaveBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        BorderThickness="0,1,0,0" Padding="16,10"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" MinWidth="90" Margin="8,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}" Click="Save_Click"/>
                        <Button x:Name="DiscardButton" DockPanel.Dock="Right" MinWidth="90" Click="Discard_Click"/>
                        <TextBlock x:Name="SaveIcon" FontFamily="Segoe Fluent Icons" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="SaveText" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="PageHost" Focusable="False"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
